SPL_ENVIRONMENT=development
SPL_APP_NAME=SL People
SPL_PEOPLE_MODULE_ENABLED=true

# This module's own database (sl_people) and the shared platform DB (sl_platform).
SPL_DATABASE_URL=mysql+aiomysql://user:password@host:3306/sl_people
SPL_PLATFORM_DATABASE_URL=mysql+aiomysql://user:password@host:3306/sl_platform

SPL_SECRET_KEY=change-me
SPL_AUTH_MODE=google
SPL_SESSION_TABLE=slp_people_session
SPL_SESSION_IDLE_MINUTES=15
SPL_GOOGLE_WORKSPACE_DOMAIN=studiolotus.in
SPL_GOOGLE_OAUTH_SECRETS_PATH=secrets/Oauth SL_Platform.json
SPL_GOOGLE_CLOCK_SKEW_SECONDS=180

# Fernet AES-256 key for PAN/Aadhaar/PF/UAN. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPL_ENCRYPTION_KEY=

# Google Sheets live-sync ingest (deferred — wired in a later phase).
SPL_SHEET_INGEST_TOKEN=
SPL_SHEET_INGEST_MAX_ROWS=0
