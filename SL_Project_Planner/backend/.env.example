SPP_ENVIRONMENT=development
SPP_DATABASE_URL=mysql+aiomysql://user:password@host:3306/sl_project_planner
SPP_PLATFORM_DATABASE_URL=mysql+aiomysql://user:password@host:3306/sl_platform
SPP_SECRET_KEY=change-me
SPP_AUTH_MODE=google
SPP_SESSION_TABLE=slp_planner_session
SPP_SESSION_IDLE_MINUTES=15
SPP_GOOGLE_WORKSPACE_DOMAIN=studiolotus.in
SPP_GOOGLE_OAUTH_SECRETS_PATH=secrets/Oauth SL_Platform.json
SPP_GOOGLE_CLOCK_SKEW_SECONDS=180
SPP_STORAGE_ROOT=storage
